<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiStartup.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MauiStartup.ViewModels"
    x:DataType="viewmodel:MainPageModel"
    Title="Зареєструватися">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            VerticalOptions="Center">

            <Label
                Text="Зареєструватися"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Введіть електронну пошту та пароль."
                FontSize="14"
                HorizontalTextAlignment="Center" />

            <Entry
                Placeholder="Електронна пошта"
                Keyboard="Email"
                Text="{Binding Email, Mode=TwoWay}" />

            <Entry
                Placeholder="Пароль"
                IsPassword="True"
                Text="{Binding Password, Mode=TwoWay}" />

            <Button
                Text="Зареєструватися"
                Command="{Binding CheckRegistrationCommand}" />

            <Label
                Text="{Binding ResultMessage}"
                IsVisible="{Binding IsResultVisible}"
                FontSize="16"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
